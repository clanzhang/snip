#!/bin/bash
# ===========================================
# ClipDoctor 快速启动脚本
# 用法: ./scripts/clipdoctor.sh [start|stop|status|log]
# ===========================================
set -euo pipefail

# 自动查找 clipdoctor：先看同目录，再查 PATH
if [ -x "$(dirname "$0")/clipdoctor" ]; then
    BINARY="$(dirname "$0")/clipdoctor"
else
    BINARY="$(command -v clipdoctor 2>/dev/null || echo /usr/local/bin/clipdoctor)"
fi
PID_FILE="$HOME/.cmdcv/clipdoctor.pid"
LOG_DIR="$HOME/.cmdcv"
MONITOR_LOG="$LOG_DIR/monitor.log"

# 确保二进制存在
if [ ! -f "$BINARY" ]; then
    echo "NOTFOUND $BINARY"
    exit 1
fi

mkdir -p "$LOG_DIR"

cmd_start() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        echo "ClipDoctor 已在运行中 (PID: $(cat "$PID_FILE"))"
        exit 0
    fi

    echo "正在启动 ClipDoctor..."

    # stderr 写入日志文件，方便排查问题
    nohup "$BINARY" >> "$MONITOR_LOG" 2>&1 &
    local pid=$!
    echo $pid > "$PID_FILE"

    # 等 0.5 秒验证进程是否存活
    sleep 0.5
    if kill -0 "$pid" 2>/dev/null; then
        echo "已启动 (PID: $pid)"
        echo "日志文件: $MONITOR_LOG"
        echo "查看日志: snip log"
    else
        rm -f "$PID_FILE"
        echo "启动失败！进程已退出，检查日志:"
        cat "$MONITOR_LOG"
        exit 1
    fi
}

cmd_stop() {
    if [ ! -f "$PID_FILE" ]; then
        echo "WARN ClipDoctor 未在运行"
        exit 0
    fi

    PID=$(cat "$PID_FILE")
    if kill "$PID" 2>/dev/null; then
        rm -f "$PID_FILE"
        echo "OK 已停止 (PID: $PID)"
    else
        echo "WARN 进程不存在，清理 PID 文件"
        rm -f "$PID_FILE"
    fi
}

cmd_status() {
    if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
        PID=$(cat "$PID_FILE")
        echo "OK ClipDoctor 运行中 (PID: $PID)"
        echo "   日志: $MONITOR_LOG"
        echo "   最近 5 条记录:"
        tail -5 "$MONITOR_LOG" 2>/dev/null || echo "   (暂无记录)"
    else
        echo "STOP ClipDoctor 未运行"
    fi
}

cmd_log() {
    if [ -f "$MONITOR_LOG" ]; then
        tail -f "$MONITOR_LOG"
    else
        echo "EMPTY 暂无日志"
    fi
}

cmd_help() {
    echo "ClipDoctor - macOS 剪贴板 & 键盘诊断工具"
    echo ""
    echo "用法: snip <command>"
    echo ""
    echo "剪贴板监控:"
    echo "  start     后台启动剪贴板监控"
    echo "  stop      停止监控"
    echo "  restart   重启监控"
    echo "  status    查看运行状态和最近日志"
    echo "  log       实时查看日志 (tail -f)"
    echo ""
    echo "键盘监控:"
    echo "  keys              监控默认快捷键 (cmd+c,cmd+v,...)"
    echo "  keys --all-keys   监控所有键盘事件"
    echo "  keys --json       JSON Lines 输出"
    echo "  keys --keys <list> 自定义快捷键，逗号分隔"
    echo ""
    echo "其他:"
    echo "  -h, --help  显示此帮助"
    echo ""
    echo "日志文件: ~/.cmdcv/monitor.log"
}

cmd_keys() {
    exec "$BINARY" keyboard watch "$@"
}

case "${1:-start}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    status)  cmd_status ;;
    log)     cmd_log ;;
    restart) cmd_stop; sleep 1; cmd_start ;;
    keys)    shift; cmd_keys "$@" ;;
    -h|--help) cmd_help ;;
    *)
        cmd_help
        exit 1
        ;;
esac